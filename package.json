{
  "name": "vue-keep-alive-iframe",
  "version": "1.0.0",
  "description": "Vue 2.7+ / Vue 3 iframe keep-alive component with LRU cache, responsive layout and programmatic API",
  "type": "module",
  "license": "MIT",
  "author": "Steven",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dianayue/vue-keep-alive-iframe.git"
  },
  "bugs": {
    "url": "https://github.com/dianayue/vue-keep-alive-iframe/issues"
  },
  "homepage": "https://github.com/dianayue/vue-keep-alive-iframe#readme",
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "vue-component",
    "iframe",
    "keep-alive",
    "cache",
    "lru",
    "responsive",
    "typescript"
  ],
  "main": "./dist/vue-keep-alive-iframe.umd.js",
  "module": "./dist/vue-keep-alive-iframe.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue-keep-alive-iframe.es.js",
      "require": "./dist/vue-keep-alive-iframe.umd.js"
    },
    "./style.css": "./dist/vue-keep-alive-iframe.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "node scripts/build.js",
    "preview": "vite preview",
    "release": "bumpp && pnpm run build:lib && pnpm publish dist/ --access public && changelogithub",
    "release:patch": "bumpp patch && pnpm run build:lib && pnpm publish dist/ --access public && changelogithub",
    "release:minor": "bumpp minor && pnpm run build:lib && pnpm publish dist/ --access public && changelogithub",
    "release:major": "bumpp major && pnpm run build:lib && pnpm publish dist/ --access public && changelogithub",
    "changelog": "changelogithub",
    "setup-env": "./scripts/setup-env.sh",
    "check-env": "./scripts/check-env.sh",
    "diagnose-env": "./scripts/diagnose-env.sh",
    "clean": "rimraf node_modules"
  },
  "dependencies": {},
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^13.3.0",
    "bumpp": "^10.1.1",
    "chalk": "4.1.2",
    "changelogithub": "^13.15.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.3",
    "unocss": "^66.1.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.8"
  },
  "peerDependencies": {
    "vue": ">=2.7.0 || >=3.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
